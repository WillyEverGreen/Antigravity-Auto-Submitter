# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Force LF on all script and runtime files for cross-platform compatibility
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific wrappers preserve CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.tgz binary
*.pyc binary
